# Required for live Bridge chat. Keep this value server-side and out of NEXT_PUBLIC_* variables.
BRIDGE_API_KEY=
BRIDGE_MODEL=auto
BRIDGE_BASE_URL=https://wekoya-api.wekoya.tech/v1
BRIDGE_EMBEDDING_MODEL=gemini-embedding-2

# Required for authentication and persistent production workspaces.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional canonical app origin for auth confirmation callbacks. Leave unset locally to use the current origin.
NEXT_PUBLIC_SITE_URL=

